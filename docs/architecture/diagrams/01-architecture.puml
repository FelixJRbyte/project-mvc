@startuml 01-architecture
!include style.puml
title Arquitectura de alto nivel - project-mvc
left to right direction

actor "Usuario" as U

node "Navegador" as B {
  component "Componentes React\nsrc/view/*" as UI
}

node "Docker Compose (docker-compose.yml)" as DC {
  node "Contenedor app\n(imagen desde Dockerfile)" as APP {
    node "Servidor Next.js :3000" as N {
      component "Rutas de página\nsrc/app/**/page.jsx" as P
      component "Rutas API\nsrc/app/api/**/route.js" as A
      component "Controladores\nsrc/controller/*" as C
      component "Modelos\nsrc/model/*" as M
    }
  }

  node "Contenedor db\n(imagen mysql:8.4)" as DBC {
    database "MySQL :3306\nbase project_mvc" as DB
  }

  storage "Volumen mysql-data" as VOL
}

U --> UI : usa
UI --> P : navega
P --> UI : renderiza
UI --> A : fetch HTTP / JSON
A --> C : delega
C --> M : consulta / persiste
M --> DB : SQL (red interna,\nhost "db")
DB --> VOL : persiste datos
@enduml
